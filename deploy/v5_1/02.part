function onlineNodes() {
  const now = Date.now();
  const nodes = [{id: state.id, name: state.name || 'Questo dispositivo', self: true, lastSeen: now}];
  for (const device of state.devices.values()) {
    if (now - device.lastSeen < DEVICE_TIMEOUT) nodes.push({...device, self: false});
  }
  return [...new Map(nodes.map(node => [node.id, node])).values()]
    .sort((a, b) => a.id.localeCompare(b.id))
    .slice(0, MAX_NODES);
}
function rosterIds() { return onlineNodes().map(node => node.id); }
function coordinatorCount() {
  const count = onlineNodes().length;
  return count >= 3 ? 2 : 1;
}
function coordinators() { return onlineNodes().slice(0, coordinatorCount()); }
function members() {
  const coordinatorIds = new Set(coordinators().map(node => node.id));
  return onlineNodes().filter(node => !coordinatorIds.has(node.id));
}
function coordinatorIndex(id = state.id) {
  return coordinators().findIndex(node => node.id === id);
}
function activeCoordinator(cycle = state.cycle) {
  const list = coordinators();
  if (!list.length) return null;
  return list[Math.max(0, cycle) % list.length];
}
function backupCoordinator(cycle = state.cycle) {
  const list = coordinators();
  if (list.length < 2) return list[0] || null;
  return list[(Math.max(0, cycle) + 1) % list.length];
}
function myRank() { return onlineNodes().findIndex(node => node.id === state.id) + 1; }
function isCoordinator(id = state.id) { return coordinatorIndex(id) >= 0; }
function touchDevice(id, name = null) {
  if (id === state.id) return false;
  const existing = state.devices.get(id);
  const firstSeen = !existing;
  state.devices.set(id, {
    id,
    name: name || existing?.name || id,
    lastSeen: Date.now()
  });

  if (firstSeen && state.selected === BROADCAST) {
    state.selected = id;
    state.unread[id] = 0;
    persist();
    showToast(`Rilevato ${name || id}: chat aperta`);
  }

  // Ogni pacchetto valido del contatto prova a sbloccare la sua coda.
  setTimeout(() => resumePendingForPeer(id), 450 + Math.random() * 700);
  return firstSeen;
}
function termIsNewer(epoch, cycle, sender) {
  if (epoch !== state.epoch) return epoch > state.epoch;
  if (cycle !== state.cycle) return cycle > state.cycle;
  if (!state.currentSyncSender) return true;
  return sender.localeCompare(state.currentSyncSender) < 0;
}

function renderAll() {
  renderIdentity();
  renderDevices();
  renderConversation();
  renderHierarchy();
}
function renderIdentity() {
  els.selfId.textContent = state.id;
  const rank = myRank();
  const coordIndex = coordinatorIndex();
  let role = directMode() ? 'modalità diretta' : `grado #${rank}`;
  if (!directMode() && coordIndex === 0) role += ' · coordinatore A';
  if (!directMode() && coordIndex === 1) role += ' · coordinatore B';
  if (!directMode() && state.currentSyncSender === state.id) role += ' · attivo';
  els.selfRank.textContent = role;

  if (state.running) {
    const now = Date.now();
    const status = state.transmitting ? 'trasmissione'
      : now < state.leaseUntil ? 'lease messaggio'
      : now < state.busyUntil ? 'occupato'
      : 'libero';
    setPill(els.channelPill, status, status === 'libero' ? 'on' : 'warn');
  }
}
function unreadBadge(id) {
  const unread = Number(state.unread[id] || 0);
  return unread ? `<span class="unread">${unread > 99 ? '99+' : unread}</span>` : '';
}
function renderDevices() {
  els.devices.innerHTML = '';

  const broadcast = document.createElement('div');
  broadcast.className = 'device' + (state.selected === BROADCAST ? ' active' : '');
  broadcast.innerHTML =
    `<div class="avatar">∞<span class="rank leader">ALL</span></div>` +
    `<div class="device-main"><div class="device-name">Tutti i dispositivi</div>` +
    `<div class="device-meta">broadcast con lease coordinata</div></div>${unreadBadge(BROADCAST)}`;
  broadcast.onclick = () => selectPeer(BROADCAST);
  els.devices.appendChild(broadcast);

  const nodes = onlineNodes().filter(node => !node.self);
  const coordinatorIds = new Set(coordinators().map(node => node.id));
  els.deviceCount.textContent = `${nodes.length} vicin${nodes.length === 1 ? 'o' : 'i'}`;

  for (const node of nodes) {
    const rank = onlineNodes().findIndex(item => item.id === node.id) + 1;
    const coordPosition = coordinators().findIndex(item => item.id === node.id);
    const role = coordPosition === 0 ? 'coordinatore A'
      : coordPosition === 1 ? 'coordinatore B'
      : `membro · slot #${members().findIndex(item => item.id === node.id) + 1}`;

    const row = document.createElement('div');
    row.className = 'device' + (state.selected === node.id ? ' active' : '');
    row.innerHTML =
      `<div class="avatar">${escapeHtml(initials(node.name))}` +
      `<span class="rank ${coordinatorIds.has(node.id) ? 'leader' : ''}">${coordinatorIds.has(node.id) ? '♛' : rank}</span>` +
      `<span class="online"></span></div>` +
      `<div class="device-main"><div class="device-name">${escapeHtml(node.name || node.id)}</div>` +
      `<div class="device-meta">${role} · ${node.id} · ${Math.max(0, Math.round((Date.now() - node.lastSeen) / 1000))}s</div></div>` +
      unreadBadge(node.id);
    row.onclick = () => selectPeer(node.id);
    els.devices.appendChild(row);
  }

  if (!nodes.length) {
    const empty = document.createElement('div');
    empty.className = 'empty';
    empty.innerHTML = 'Nessun dispositivo vicino.<br>Con 3–5 telefoni verranno eletti automaticamente due coordinatori.';
    els.devices.appendChild(empty);
  }
}
function selectPeer(id) {
  state.selected = id;
  state.unread[id] = 0;
  persist();
  renderDevices();
  renderConversation();
  if (innerWidth <= 800) els.sidebar.classList.remove('open');
}
function peerInfo(id) {
  if (id === BROADCAST) return {id, name: 'Tutti i dispositivi', broadcast: true};
  return state.devices.get(id) || {id, name: id, broadcast: false};
}
function history(id) { return state.histories[id] || (state.histories[id] = []); }
function trimHistory(id) { state.histories[id] = history(id).slice(-250); }
function renderConversation() {
  const peer = peerInfo(state.selected);
  els.chatAvatar.textContent = peer.broadcast ? '∞' : initials(peer.name);
  els.chatTitle.textContent = peer.name;
  els.chatSub.textContent = peer.broadcast
    ? (directMode()
        ? 'broadcast diretto · scrivi e premi ➤'
        : 'broadcast · concessione condivisa dai coordinatori')
    : (directMode()
        ? `ID ${peer.id} · collegamento diretto + ACK`
        : `ID ${peer.id} · lease coordinata + ACK`);

  els.messages.innerHTML = '';
  const items = history(state.selected);
  if (!items.length) {
    els.messages.innerHTML = `<div class="system">${
      peer.broadcast
        ? (directMode()
            ? 'Con due telefoni puoi inviare subito. Per un messaggio privato seleziona il contatto.'
            : 'Il broadcast parte dopo una concessione del coordinatore attivo.')
        : (directMode()
            ? 'Scrivi il messaggio nel campo in basso e premi ➤.'
            : 'Nessun messaggio in questa conversazione.')
    }</div>`;
  } else {
    for (const message of items) {
      const bubble = document.createElement('div');
      bubble.className = 'bubble' + (message.direction === 'out' ? ' mine' : '');
      const sender = peer.broadcast && message.direction === 'in'
        ? `<b>${escapeHtml(message.fromName || message.from)}</b><br>` : '';
      bubble.innerHTML =
        `<div>${sender}${escapeHtml(message.text).replace(/\n/g, '<br>')}</div>` +
        `<div class="meta">${nowTime(message.ts)} ${message.direction === 'out' ? statusIcon(message.status) : ''}</div>`;
      els.messages.appendChild(bubble);
    }
  }
  els.messages.scrollTop = els.messages.scrollHeight;
  els.sendBtn.disabled = !state.running || !state.name;
}
function statusIcon(status) {
  if (status === 'delivered') return '<span class="status-icon ok">✓✓</span>';
  if (status === 'waiting_offline') return '<span class="status-icon pending" title="In attesa del destinatario">🕓</span>';
  if (status === 'failed') return '<span class="status-icon fail">!</span>';
  if (status === 'granted' || status === 'transmitting') return '<span class="status-icon pending">◌</span>';
  return '<span class="status-icon pending">✓</span>';
}
function renderHierarchy() {
  els.hierarchyList.innerHTML = '';
  const coordinatorIds = new Set(coordinators().map(node => node.id));
  onlineNodes().forEach((node, index) => {
    const coordPosition = coordinators().findIndex(item => item.id === node.id);
    const label = coordPosition === 0 ? 'A'
      : coordPosition === 1 ? 'B'
      : `slot ${members().findIndex(item => item.id === node.id) + 1}`;
    const row = document.createElement('div');
    row.className = 'hierarchy-item';
    row.innerHTML =
      `<b>${coordinatorIds.has(node.id) ? '♛' : '#' + (index + 1)}</b>` +
      `<div class="grow">${escapeHtml(node.name || node.id)} · ${label}` +
      `${node.self ? ' <span class="pill on">questo iPhone</span>' : ''}</div>` +
      `<code>${node.id}</code>`;
    els.hierarchyList.appendChild(row);
  });

  const agreement = document.createElement('div');
  agreement.className = 'hierarchy-item';
  agreement.innerHTML =
    `<b>↔</b><div class="grow">Stato coordinamento</div><code>${escapeHtml(state.coordinatorAgreement)}</code>`;
  els.hierarchyList.appendChild(agreement);
}

function packControl(type, data = {}) {
  let variable = '';
  if (type === 'C') {
    variable =
      toB36(data.epoch, 2) +
      toB36(data.cycle, 2) +
      toB36(data.count, 1) +
      String(data.hash || '0000').slice(0, 4) +
      toB36(data.coordinatorCount, 1) +
      '01';
  } else if (type === 'V') {
    variable =
      String(data.leader || BROADCAST).slice(0, 7) +
      toB36(data.epoch, 2) +
      toB36(data.cycle, 2) +
      String(data.hash || '0000').slice(0, 4) +
      String(data.status || 'O').slice(0, 1);
  } else if (type === 'P') {
    variable =
      toB36(data.epoch, 2) +
      toB36(data.cycle, 2) +
      toB36(data.rank, 1) +
      String(data.hash || '0000').slice(0, 4);
  } else if (type === 'H') {
    const name = asciiName(data.name || state.name);
    variable = toB36(name.length, 1) + name;
  } else if (type === 'J') {
    variable = String(data.nonce || randomId(3)).slice(0, 3) + String(data.nameHash || '0000').slice(0, 4);
  } else if (type === 'Y') {
    variable =
      String(data.target || BROADCAST).slice(0, 7) +
      toB36(data.epoch, 2) +
      toB36(data.rank, 1);
  } else if (type === 'R') {
    variable = String(data.target || BROADCAST).slice(0, 7);
  } else if (type === 'Q') {
    variable =
      String(data.coordinator || BROADCAST).slice(0, 7) +
      String(data.token || '00000').slice(0, 5) +
      toB36(data.parts || 1, 1) +
      String(data.profile || 'L').slice(0, 1);
  } else if (type === 'G') {
    variable =
      String(data.target || BROADCAST).slice(0, 7) +
      String(data.token || '00000').slice(0, 5) +
      toB36(data.leaseSeconds || 8, 1) +
      toB36(data.cycle || 0, 2);
  } else if (type === 'A') {
    variable =
      String(data.target || BROADCAST).slice(0, 7) +
      String(data.token || '00000').slice(0, 5) +
      toB36(data.part || 0, 1);
  } else {
    throw new Error(`Controllo non supportato: ${type}`);
  }
  return finishPacket(packetPrefix(type) + variable, CONTROL_SIZE);
}
function unpackControl(packet) {
  if (!validatePacket(packet, CONTROL_SIZE)) return null;
  if (packet.slice(0, 2) !== 'A4') return null;
  const type = packet[2];
  const room = packet.slice(3, 5);
  const sender = packet.slice(5, 12);
  if (room !== roomCode() || sender === state.id) return null;
  return {type, sender, body: packet.slice(12, -4).replace(/~+$/g, '')};
}
function packIdentity(target = BROADCAST) {
  const safeName = splitUtf8((state.name || state.id).slice(0, 20), 24)[0] || state.id;
  const encoded = textToB64(safeName);
  const content =
    packetPrefix('I') +
    String(target).slice(0, 7) +
    toB36(encoded.length, 2) +
    encoded;
  return finishPacket(content, SHORT_SIZE);
}
function packRoster() {
  const ids = rosterIds().slice(0, MAX_NODES);
  const content =
    packetPrefix('L') +
    toB36(state.epoch, 2) +
    toB36(Math.max(0, state.cycle), 2) +
    toB36(ids.length, 1) +
    ids.join('');
  return finishPacket(content, SHORT_SIZE);
}
function unpackShortControl(packet) {
  if (!validatePacket(packet, SHORT_SIZE)) return null;
  if (packet.slice(0, 2) !== 'A4') return null;
  const type = packet[2];
  if (type !== 'I' && type !== 'L') return null;
  const room = packet.slice(3, 5);
  const sender = packet.slice(5, 12);
  if (room !== roomCode() || sender === state.id) return null;
  return {type, sender, body: packet.slice(12, -4).replace(/~+$/g, '')};
}
function packData(type, target, token, part, total, text, size) {
  const encoded = textToB64(text);
  const capacity = size === SHORT_SIZE ? 32 : 64;
  if (encoded.length > capacity) throw new Error(`Payload ${encoded.length} > ${capacity}`);
  const content =
    packetPrefix(type) +
    String(target).slice(0, 7) +
    String(token).slice(0, 5) +
    toB36(part, 1) +
    toB36(total, 1) +
    toB36(encoded.length, 2) +
    encoded;
  return finishPacket(content, size);
}
function unpackData(packet, size) {
  if (!validatePacket(packet, size)) return null;
  if (packet.slice(0, 2) !== 'A4') return null;
  const type = packet[2];
  if (type !== 'S' && type !== 'M') return null;
  const room = packet.slice(3, 5);
  const sender = packet.slice(5, 12);
  if (room !== roomCode() || sender === state.id) return null;
  const target = packet.slice(12, 19);
  const token = packet.slice(19, 24);
  const part = fromB36(packet[24]);
  const total = fromB36(packet[25]);
  const length = fromB36(packet.slice(26, 28));
  const payload = packet.slice(28, 28 + length);
  try {
    return {type, sender, target, token, part, total, text: b64ToText(payload)};
  } catch {
    return null;
  }
}

function queuePacket(item) {
  item.qid ||= randomId(6);
  item.dueAt ||= Date.now();
  item.priority ??= 5;
  item.attempts ||= 0;
  state.txQueue.push(item);
  state.txQueue.sort((a, b) => a.priority - b.priority || a.dueAt - b.dueAt);
}
function clearFrameTimers() {
  for (const timer of state.frameTimers) clearTimeout(timer);
  state.frameTimers.clear();
}
function frameTimeout(callback, delay) {
  const timer = setTimeout(() => {
    state.frameTimers.delete(timer);
    callback();
  }, Math.max(0, delay));
  state.frameTimers.add(timer);
}
function queueSync(epoch, cycle, takeover = false) {
  const key = `${epoch}:${cycle}`;
  if (state.syncQueuedFor === key) return;
  state.syncQueuedFor = key;
  queuePacket({
    kind: takeover ? 'SYNC takeover' : 'SYNC',
    channel: 'control',
    payload: packControl('C