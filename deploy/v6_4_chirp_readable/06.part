=start+1;i<end;i++){const v=state.analyserData[i];if(v>median+11&&v>state.analyserData[i-1]+1.5&&v>state.analyserData[i+1]+1.5){peaks++;if(spreadFirst<0)spreadFirst=i;spreadLast=i}}const coherent=peaks>=4&&spreadLast-spreadFirst>8&&state.rxLevel>Math.max(.0007,state.noiseFloor*3.8);if(coherent){if(!state.carrierActive)log(`Carrier modem probabile · ${peaks} picchi`);state.carrierActive=true;state.carrierUntil=Math.max(state.carrierUntil,Date.now()+900)}else if(state.carrierActive&&Date.now()>state.carrierUntil){state.carrierActive=false;log('Carrier libero · backoff attivo')}}
function maintenance(){const now=Date.now();
 if(state.running&&state.devices.size===0&&state.networkPhase==='LISTEN_ONLY'&&now>=state.electionAt)becomeCoordinator();
 if(state.joinAbsoluteUntil&&now>=state.joinAbsoluteUntil){
  log('Timeout assoluto JOIN · ripresa rete','err');
  state.quietUntil=0;state.joinSessionUntil=0;state.joinAbsoluteUntil=0;state.joinCandidateId=null;
  setPhase(state.devices.size?'ACTIVE':'LISTEN_ONLY');
  if(!state.devices.size)scheduleElection()
 }
for(const [id,d] of state.devices)if(now-d.lastSeen>DEVICE_TIMEOUT){state.devices.delete(id);state.rosterVersion++;log(`${d.name||id} offline`);for(const rec of state.outgoing.values())if(rec.targetId===id){rec.status='queued';dbPut(rec)}}for(const [k,a] of state.assemblies)if(now-a.at>90000)state.assemblies.delete(k);for(const [id,c] of state.pendingClaims)if(now-c.at>20000)state.pendingClaims.delete(id);if(state.lease&&now>state.lease.until)state.lease=null;
 if(state.running&&state.devices.size===0&&now>=state.nextDiscoveryRoundAt&&state.networkPhase==='COORDINATOR'){state.helloScheduledRound=-1;scheduleHello('beacon coordinatore');state.nextDiscoveryRoundAt=now+DISCOVERY_ROUND_MS}
 if(state.running&&state.devices.size>0&&now>=state.nextPresenceAt)schedulePresence();
 if(state.running&&state.devices.size>0&&isCoordinator()&&now>=state.nextSyncAt)scheduleSync();
 if(state.running){for(const rec of state.outgoing.values())if(rec.status==='queued'&&(rec.targetAddr===BROADCAST||roster().some(n=>n.id===rec.targetId))){rec.targetAddr=rec.targetAddr===BROADCAST?BROADCAST:addressOf(rec.targetId);beginDelivery(rec)}}}

function renderStatus(){const addr=ownAddress();els.selfAddress.textContent=addr<10?`#${addr}`:'#—';els.slotBadge.textContent=isQuiet()?'silenzio':Date.now()<state.listenUntil?'ascolto':reserveActive()?`lease #${state.lease.owner}`:`#${slotOwnerAddr()}`;if(!state.running)setBadge(els.carrierBadge,'inattivo');else if(isQuiet())setBadge(els.carrierBadge,state.networkPhase,'warn');else if(Date.now()<state.listenUntil)setBadge(els.carrierBadge,'finestra RX','ok');else if(carrierBusy())setBadge(els.carrierBadge,'occupato','warn');else setBadge(els.carrierBadge,'libero','ok');els.rxReadout.textContent=`${state.networkPhase} · RMS ${state.rxLevel.toFixed(5)} · chirp M${state.chirpScores.MASTER.toFixed(2)} J${state.chirpScores.JOIN.toFixed(2)} R${state.chirpScores.RESUME.toFixed(2)} · collisioni ${state.collisionTotal}`}
function renderDevices(){els.devices.innerHTML='';const all=document.createElement('div');all.className='device '+(state.selected===BROADCAST?'active':'');all.innerHTML=`<div class="avatar">∞<span class="addr coord">ALL</span></div><div class="device-main"><div class="device-name">Tutta la rete</div><div class="device-meta">broadcast cifrato e autenticato</div></div>`;all.onclick=()=>selectAddress(BROADCAST);els.devices.appendChild(all);const nodes=roster().filter(n=>!n.self);els.deviceCount.textContent=`${nodes.length} vicin${nodes.length===1?'o':'i'}`;for(const n of nodes){const addr=addressOf(n.id),coord=n.id===coordinator().id,row=document.createElement('div');row.className='device '+(state.selected===addr?'active':'');row.innerHTML=`<div class="avatar">${escapeHtml(initials(n.name))}<span class="addr ${coord?'coord':''}">${coord?'♛':addr}</span><span class="role-dot"></span></div><div class="device-main"><div class="device-name">${escapeHtml(n.name||n.id)}</div><div class="device-meta">${n.confirmed?'● confermato':'◐ rilevato'} · ${coord?'coordinatore':`slot ${addr}`} · ${Math.round((Date.now()-n.lastSeen)/1000)}s</div></div><div class="quality">${Math.round(n.quality||0)}%</div>`;row.onclick=()=>selectAddress(addr);els.devices.appendChild(row)}if(!nodes.length){const e=document.createElement('div');e.className='empty-chat';e.innerHTML='<b>Nessun nodo vicino</b>Avvia la rete sul secondo dispositivo usando lo stesso nome rete e la stessa password.';els.devices.appendChild(e)}}
function selectAddress(addr){state.selected=addr;const n=selectedNode();const id=n?.id||'broadcast';state.unread[id]=0;persist();renderConversation();renderDevices();els.sidebar.classList.remove('open')}
function renderConversation(){const n=selectedNode(),key=n?.id||'broadcast';els.chatTitle.textContent=n?.name||'Tutta la rete';els.chatSub.textContent=n?`indirizzo #${addressOf(n.id)} · ${n.confirmed?'collegamento confermato':'solo rilevato'}`:'broadcast cifrato · nessun nome rete in chiaro';els.chatAvatar.textContent=n?initials(n.name):'∞';els.messages.innerHTML='';const msgs=history(key);if(!msgs.length){const e=document.createElement('div');e.className='empty-chat';e.innerHTML=n?'<b>Conversazione cifrata</b>I messaggi non consegnati restano in coda sul mittente.':'<b>Rete acustica pronta</b>Apri la dashboard per vedere slot, qualità dei collegamenti e statistiche.';els.messages.appendChild(e);return}for(const m of msgs){const b=document.createElement('div');b.className='bubble '+(m.mine?'mine':'');b.innerHTML=`<div>${escapeHtml(m.text)}</div><div class="meta"><span>${new Date(m.time).toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'})}</span><span>${m.mine?statusIcon(m.status):''}</span></div>`;els.messages.appendChild(b)}els.messages.scrollTop=els.messages.scrollHeight}
function renderDashboard(){const nodes=roster(),confirmed=nodes.filter(n=>n.self||n.confirmed).length;els.mNodes.textContent=String(confirmed);const total=state.ackedCount+state.failedCount;els.mDelivery.textContent=total?Math.round(state.ackedCount/total*100)+'%':'—';const now=Date.now();state.carrierSamples.push([now,carrierBusy()?1:0]);state.carrierSamples=state.carrierSamples.filter(x=>now-x[0]<60000);els.mBusy.textContent=(state.carrierSamples.length?Math.round(state.carrierSamples.reduce((s,x)=>s+x[1],0)/state.carrierSamples.length*100):0)+'%';els.mSecurity.textContent=String(state.authFailures+state.replayDrops);els.topology.innerHTML='';const count=nodes.length||1,positions=[];nodes.forEach((n,i)=>{const angle=count===1?0:(Math.PI*2*i/count-Math.PI/2),r=count<=2?27:37,x=count===1?50:50+Math.cos(angle)*r,y=count===1?50:50+Math.sin(angle)*r;positions.push([x,y]);if(i>0){const [x0,y0]=positions[0],dx=x-x0,dy=y-y0,len=Math.sqrt(dx*dx+dy*dy),edge=document.createElement('div');edge.className='edge '+((n.quality||0)>55?'good':'');edge.style.left=x0+'%';edge.style.top=y0+'%';edge.style.width=len+'%';edge.style.transform=`rotate(${Math.atan2(dy,dx)*180/Math.PI}deg)`;els.topology.appendChild(edge)}});nodes.forEach((n,i)=>{const [x,y]=positions[i],d=document.createElement('div'),coord=n.id===coordinator().id;d.className=`topo-node ${n.self?'self':''} ${coord?'coord':''}`;d.style.left=`calc(${x}% - 46px)`;d.style.top=`calc(${y}% - 46px)`;d.innerHTML=`<div><b>${escapeHtml(n.name||n.id)}</b><small>#${addressOf(n.id)} ${coord?'♛':''}<br>${n.self?'questo dispositivo':`${Math.round(n.quality||0)}% link`}</small></div>`;els.topology.appendChild(d)});els.nodeStats.innerHTML='';for(const n of nodes){const q=n.self?100:Math.round(n.quality||0),card=document.createElement('div');card.className='node-card';card.innerHTML=`<div class="node-card-head"><b>${escapeHtml(n.name||n.id)}</b><span class="badge ${n.confirmed||n.self?'ok':'warn'}">#${addressOf(n.id)} ${n.confirmed||n.self?'confermato':'rilevato'}</span></div><div><small class="muted">Qualità collegamento ${q}%</small><div class="bar"><span style="width:${q}%"></span></div></div><div class="row gap12 wrap"><span class="badge">ultimo ${n.self?0:Math.round((Date.now()-n.lastSeen)/1000)}s</span><span class="badge">${n.id===coordinator().id?'coordinatore':'membro'}</span></div>`;els.nodeStats.appendChild(card)}}
function renderAll(){els.selfName.textContent=state.name||'—';els.fingerprint.textContent=state.fingerprint?`FP ${state.fingerprint}`:'fingerprint —';renderStatus();renderDevices();renderConversation();renderDashboard()}

async function joinNetwork(){const name=els.joinName.value.trim(),network=els.joinNetwork.value.trim(),password=els.joinPassword.value;if(!name){toast('Inserisci il nome del dispositivo');return}if(!network){toast('Inserisci il nome della rete');return}if(password.length<8){toast('Password di almeno 8 caratteri');return}els.joinBtn.disabled=true;els.joinBtn.textContent='Derivo la chiave…';try{state.name=name.slice(0,12);state.remember=els.rememberKey.checked;await deriveNetwork(network,password);persist();if(state.remember)localStorage.setItem('audiomesh6.master',JSON.stringify({network:state.network,master:b64url(state.masterBytes),fingerprint:state.fingerprint}));else localStorage.removeItem('audiomesh6.master');els.onboarding.classList.add('hidden');await restoreOutbox();renderAll();toast('Rete pronta: '+state.fingerprint)}catch(e){toast('Errore sicurezza: '+e.message)}finally{els.joinBtn.disabled=false;els.joinBtn.textContent='Crea o entra nella rete'}}
async function resumeNetwork(){const k=JSON.parse(localStorage.getItem('audiomesh6.master')||'null');if(!k){toast('Nessuna chiave ricordata');return}state.name=saved.name||els.joinName.value.trim()||'Dispositivo';await deriveNetwork(k.network,'',fromB64url(k.master));els.onboarding.classList.add('hidden');renderAll();toast('Rete ripristinata')}

els.joinName.value=state.name;els.joinNetwork.value=state.network;els.resumeBtn.style.display=localStorage.getItem('audiomesh6.master')?'':'none';els.joinBtn.onclick=joinNetwork;els.resumeBtn.onclick=resumeNetwork;els.showDocsWelcome.onclick=()=>els.docsOverlay.classList.add('open');els.startBtn.onclick=startNetwork;els.announceBtn.onclick=requestJoin;els.sendBtn.onclick=sendMessage;els.messageInput.addEventListener('keydown',e=>{if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();sendMessage()}});els.messageInput.addEventListener('input',()=>{els.messageInput.style.height='auto';els.messageInput.style.height=Math.min(125,els.messageInput.scrollHeight)+'px'});els.openSidebar.onclick=()=>els.sidebar.classList.add('open');els.closeSidebar.onclick=()=>els.sidebar.classList.remove('open');els.dashboardBtn.onclick=()=>{renderDashboard();els.dashboardOverlay.classList.add('open')};els.docsBtn.onclick=()=>els.docsOverlay.classList.add('open');els.settingsBtn.onclick=()=>els.settingsOverlay.classList.add('open');$$('.closeModal').forEach(b=>b.onclick=()=>b.closest('.overlay').classList.remove('open'));$$('.overlay').forEach(o=>o.addEventListener('click',e=>{if(e.target===o)o.classList.remove('open')}));
els.volumeInput.value=state.volume;els.volumeValue.textContent=state.volume;els.volumeInput.oninput=()=>{state.volume=Number(els.volumeInput.value);els.volumeValue.textContent=state.volume;persist()};els.boostInput.value=state.boost;els.boostValue.textContent=state.boost.toFixed(1)+'×';els.boostInput.oninput=()=>{state.boost=Number(els.boostInput.value);els.boostValue.textContent=state.boost.toFixed(1)+'×';if(state.txGain)state.txGain.gain.value=state.boost;persist()};els.agcInput.value=state.agcMax;els.agcValue.textContent=state.agcMax+'×';els.agcInput.oninput=()=>{state.agcMax=Number(els.agcInput.value);els.agcValue.textContent=state.agcMax+'×';persist()};els.testToneBtn.onclick=async()=>{if(!state.context){toast('Avvia prima la rete');return}await state.context.resume();const o=state.context.createOscillator(),g=state.context.createGain();o.frequency.value=2400;g.gain.setValueAtTime(.0001,state.context.currentTime);g.gain.exponentialRampToValueAtTime(.16,state.context.currentTime+.03);g.gain.exponentialRampToValueAtTime(.0001,state.context.currentTime+.5);o.connect(g);g.connect(ensureOutput());o.start();o.stop(state.context.currentTime+.52)};els.showLog.onchange=()=>els.logPanel.classList.toggle('open',els.showLog.checked);els.copyLogBtn.onclick=async()=>{try{await navigator.clipboard.writeText(state.logLines.join('\n'));toast('Log copiato')}catch{toast('Copia non disponibile')}};els.clearLogBtn.onclick=()=>{state.logLines=[];els.logPanel.innerHTML=''};els.clearDataBtn.onclick=()=>{if(!confirm('Cancellare identità, chiave, messaggi e coda?'))return;stopNetwork();localStorage.removeItem('audiomesh6.profile');localStorage.removeItem('audiomesh6.master');indexedDB.deleteDatabase('AudioMesh6');location.reload()};document.addEventListener('visibilitychange',()=>{if(document.visibilityState==='visible'&&state.running){state.context?.resume();state.carrierUntil=Date.now()+1000;schedulePresence(true)}});

persist();renderAll();log(`AudioMesh ${VERSION} pronta · frame cifrati uniformi 64 · un solo decoder fixed-length`,'ok');
})();
</script>
</body>
</html>