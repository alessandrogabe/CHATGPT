urn btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/g, '');
}
function base64UrlToBytes(text) {
  const normalized = text.replace(/-/g, '+').replace(/_/g, '/');
  const padded = normalized + '='.repeat((4 - normalized.length % 4) % 4);
  const binary = atob(padded);
  return Uint8Array.from(binary, char => char.charCodeAt(0));
}
function textToB64(text) { return bytesToBase64Url(new TextEncoder().encode(text)); }
function b64ToText(text) { return new TextDecoder().decode(base64UrlToBytes(text)); }
function splitUtf8(text, maxBytes) {
  const result = [];
  let current = '';
  let bytes = 0;
  for (const char of text) {
    const length = new TextEncoder().encode(char).length;
    if (current && bytes + length > maxBytes) {
      result.push(current);
      current = char;
      bytes = length;
    } else {
      current += char;
      bytes += length;
    }
  }
  if (current) result.push(current);
  return result;
}
function rosterHash(ids = rosterIds()) {
  let hash = 2166136261;
  for (const char of ids.join('')) {
