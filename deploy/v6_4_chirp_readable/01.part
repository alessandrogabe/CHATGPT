-space:nowrap;overflow:hidden;text-overflow:ellipsis}.quality{width:34px;text-align:right;font-size:11px;color:#9fc7d2}
.chat{display:flex;flex-direction:column;min-width:0;min-height:0;background:linear-gradient(rgba(7,17,22,.95),rgba(7,17,22,.95)),radial-gradient(circle at 40% 30%,#27404a 1px,transparent 1px);background-size:auto,24px 24px}.chat-head{height:70px;flex:0 0 70px;background:rgba(16,29,36,.94);backdrop-filter:blur(16px);border-bottom:1px solid var(--line);display:flex;align-items:center;gap:10px;padding:0 14px}.chat-person{min-width:0;flex:1}.chat-title{font-weight:850;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.chat-sub{font-size:10px;color:var(--muted);margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.mobile-menu{display:none}
.messages{flex:1;min-height:0;overflow:auto;padding:18px max(12px,5vw);display:flex;flex-direction:column;gap:8px;scroll-behavior:smooth}.bubble{max-width:min(78%,680px);align-self:flex-start;background:var(--panel2);padding:9px 11px 6px;border-radius:13px 13px 13px 4px;box-shadow:0 2px 8px rgba(0,0,0,.12);overflow-wrap:anywhere}.bubble.mine{align-self:flex-end;background:var(--mine);border-radius:13px 13px 4px 13px}.bubble .meta{font-size:9px;color:#acc1c8;display:flex;justify-content:flex-end;gap:5px;margin-top:5px}.system-msg{align-self:center;max-width:650px;background:#102229;color:var(--muted);font-size:10px;padding:6px 9px;border-radius:9px;text-align:center}.empty-chat{margin:auto;text-align:center;color:var(--muted);max-width:480px;line-height:1.5}.empty-chat b{display:block;color:var(--text);font-size:18px;margin-bottom:5px}
.compose{flex:0 0 auto;padding:10px 12px calc(10px + var(--safe));background:rgba(16,29,36,.96);border-top:1px solid var(--line);display:flex;gap:8px;align-items:flex-end}.compose textarea{flex:1;min-height:47px;max-height:125px;resize:none;border:1px solid transparent;border-radius:14px;background:var(--panel2);color:var(--text);padding:12px;outline:none}.compose textarea:focus{border-color:var(--accent)}.send{width:49px;height:49px;border-radius:50%;border:0;background:var(--accent);color:#032d24;font-size:20px;font-weight:950;cursor:pointer}.send:disabled{opacity:.4}
/* overlays dashboard */
.overlay{position:fixed;inset:0;background:rgba(0,0,0,.72);z-index:50;display:none;align-items:center;justify-content:center;padding:16px}.overlay.open{display:flex}.modal{width:min(720px,100%);max-height:92dvh;overflow:auto;background:linear-gradient(180deg,#101f27,#0b171d);border:1px solid var(--line);border-radius:22px;box-shadow:var(--shadow)}.modal.wide{width:min(1000px,100%)}.modal-head{position:sticky;top:0;z-index:2;background:rgba(16,31,39,.94);backdrop-filter:blur(14px);padding:15px 17px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between}.modal-head h2{font-size:16px;margin:0}.modal-body{padding:17px;display:grid;gap:15px}.modal-actions{padding:13px 17px;border-top:1px solid var(--line);display:flex;justify-content:flex-end;gap:8px}
.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:9px}.metric{padding:14px;border-radius:16px;background:var(--panel2);border:1px solid var(--line)}.metric small{color:var(--muted);font-size:10px}.metric strong{font-size:26px;display:block;margin-top:5px;letter-spacing:-.03em}.metric em{font-style:normal;color:#8fc1ce;font-size:10px}
.topology{position:relative;min-height:340px;border-radius:20px;background:radial-gradient(circle at center,rgba(32,215,165,.12),transparent 48%),linear-gradient(145deg,#09171d,#0d2027);border:1px solid var(--line);overflow:hidden}.topo-node{position:absolute;width:92px;height:92px;border-radius:50%;display:grid;place-items:center;text-align:center;padding:8px;background:#17343d;border:2px solid #3e6a75;z-index:2;font-size:10px;transition:.25s}.topo-node.self{background:#075849;border-color:var(--accent)}.topo-node.coord{box-shadow:0 0 0 6px rgba(255,195,90,.12);border-color:var(--warn)}.topo-node b{display:block;font-size:11px}.topo-node small{color:#b9cbd1}.edge{position:absolute;height:2px;background:linear-gradient(90deg,rgba(99,199,255,.06),rgba(99,199,255,.55),rgba(99,199,255,.06));transform-origin:left center;z-index:1}.edge.good{background:linear-gradient(90deg,rgba(32,215,165,.06),rgba(32,215,165,.7),rgba(32,215,165,.06))}
.node-stats{display:grid;grid-template-columns:repeat(2,1fr);gap:9px}.node-card{padding:13px;border-radius:15px;background:var(--panel2);border:1px solid var(--line);display:grid;gap:8px}.node-card-head{display:flex;justify-content:space-between;align-items:center}.bar{height:9px;border-radius:999px;background:#0b171d;overflow:hidden}.bar span{display:block;height:100%;border-radius:inherit;background:linear-gradient(90deg,var(--accent2),var(--accent))}
.settings-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.setting{padding:13px;border-radius:15px;background:var(--panel2);border:1px solid var(--line);display:grid;gap:8px}.setting h3{font-size:12px;margin:0}.setting label{font-size:11px;color:#d7e5e9}.setting input[type=range]{width:100%}.setting small{font-size:10px;color:var(--muted);line-height:1.4}
.docs{line-height:1.55;color:#c8d7dc}.docs h3{margin:12px 0 5px;color:var(--text)}.docs code,.codebox{font-family:ui-monospace,SFMono-Regular,Menlo,monospace}.codebox{padding:13px;border-radius:13px;background:#071116;border:1px solid var(--line);overflow:auto;color:#bce4ef;font-size:11px;white-space:pre}.spec-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:7px}.spec-cell{padding:10px;border-radius:10px;background:var(--panel2);border:1px solid var(--line);font-size:10px;text-align:center}.license{padding:14px;border-radius:14px;background:rgba(32,215,165,.07);border:1px solid rgba(32,215,165,.22);color:#cce7df;font-size:11px;line-height:1.5}
.log-panel{position:fixed;left:10px;right:10px;bottom:calc(76px + var(--safe));max-height:34vh;overflow:auto;display:none;z-index:40;background:#041015;border:1px solid var(--line);border-radius:14px;padding:10px;font:10px ui-monospace,SFMono-Regular,monospace;color:#b6d3dc;box-shadow:var(--shadow)}.log-panel.open{display:block}.log-line{padding:3px 0;border-bottom:1px solid rgba(255,255,255,.05)}.log-ok{color:#7debc9}.log-err{color:#ff9da2}.toast{position:fixed;left:50%;bottom:84px;transform:translate(-50%,20px);opacity:0;pointer-events:none;z-index:120;background:#eef9f6;color:#0a2822;padding:10px 13px;border-radius:11px;font-size:12px;font-weight:800;transition:.2s;box-shadow:var(--shadow)}.toast.show{opacity:1;transform:translate(-50%,0)}
@media(max-width:850px){.app{grid-template-columns:1fr}.sidebar{position:fixed;inset:0;width:100%;transform:translateX(-104%);transition:.22s}.sidebar.open{transform:none}.mobile-menu{display:inline-grid;place-items:center}.value-grid{grid-template-columns:1fr 1fr}.join-panel{grid-template-columns:1fr}.metrics{grid-template-columns:1fr 1fr}.node-stats{grid-template-columns:1fr}.settings-grid{grid-template-columns:1fr}.spec-grid{grid-template-columns:1fr 1fr}.hero-main,.join-copy,.join-form{padding:24px}.topology{min-height:300px}}
@media(max-width:480px){.value-grid,.metrics{grid-template-columns:1fr}.hero h1{font-size:42px}.flow{grid-template-columns:1fr}.topo-node{width:76px;height:76px}.spec-grid{grid-template-columns:1fr}}
</style>
</head>
<body>
<section class="onboarding" id="onboarding">
  <div class="onboard-inner">
    <article class="hero">
      <div class="hero-main">
        <span class="kicker">◉ OPEN ACOUSTIC NETWORK · AES‑GCM · MIT</span>
        <h1>Una rete locale che viaggia nel suono.</h1>
        <p class="hero-lead">AudioMesh collega fino a 10 telefoni o dispositivi embedded usando esclusivamente microfono e altoparlante. I pacchetti hanno lunghezza uniforme, sono cifrati e autenticati: chi non possiede la chiave rileva soltanto attività digitale indistinguibile.</p>
        <div class="value-grid">
          <div class="value"><b>Nessuna infrastruttura</b><small>Niente Internet, SIM, Bluetooth, Wi‑Fi o server.</small></div>
          <div class="value"><b>Ascolto prima del TX</b><small>La portante sospende anche presentazioni e heartbeat.</small></div>
          <div class="value"><b>Turni distribuiti</b><small>Indirizzi locali 0–9, slot sincronizzati e lease lunghe.</small></div>
          <div class="value"><b>Protocollo aperto</b><small>Specifica, sorgenti e implementazioni sotto licenza MIT.</small></div>
        </div>
      </div>
      <div class="join-panel">
        <div class="join-copy">
          <h2>Come funziona</h2>
          <div class="flow">
            <div class="flow-step"><b>HELLO</b>identità cifrata</div><div class="flow-step"><b>ROSTER</b>indirizzo corto</div><div class="flow-step"><b>SYNC</b>turni comuni</div><div class="flow-step"><b>DATA</b>lease e frammenti</div><div class="flow-step"><b>ACK</b>consegna certa</div>
          </div>
          <p class="muted">La password non viene trasmessa. Nome rete e tipo di pacchetto restano dentro AES‑GCM. La chiave di sessione ruota ogni ora; nonce e contatori impediscono il riuso e i replay vengono scartati.</p>
          <button class="btn ghost" id="showDocsWelcome">Documentazione per implementatori</button>
        </div>
        <div class="join-form">
          <label class="field-label">Nome del dispositivo<input class="field" id="joinName" maxlength="12" placeholder="es. iPhone Ale"></label>
          <label class="field-label">Nome rete<input class="field" id="joinNetwork" maxlength="24" value="LOCALE" autocomplete="off"></label>
          <label class="field-label">Password rete<input class="field" id="joinPassword" type="password" minlength="8" maxlength="64" placeholder="almeno 8 caratteri" autocomplete="new-password"></label>
          <label class="check"><input type="checkbox" id="rememberKey"> Ricorda la chiave derivata su questo dispositivo</label>
          <div class="helper" id="securityHint">Una password lunga e non comune protegge anche da tentativi a dizionario sul nome della rete.</div>
          <div class="form-actions"><button class="btn" id="joinBtn">Crea o entra nella rete</button><button class="btn secondary" id="resumeBtn">Riprendi ultima rete</button></div>
        </div>
      </div>
    </article>
  </div>
</section>

<div class="app">
  <aside class="sidebar" id="sidebar">
    <div class="brand"><div class="brand-main"><div class="logo">AM</div><div><h1>AudioMesh 6.4</h1><small>secure acoustic mesh · MIT</small></div></div><button class="icon-btn" id="closeSidebar">×</button></div>
    <div class="profile">
      <div class="identity-line"><b id="selfName">—</b><span class="badge" id="selfAddress">#—</span></div>
      <div class="identity-line"><span class="network-fingerprint mono" id="fingerprint">fingerprint —</span><span class="badge ok">AES‑GCM</span></div>
    </div>
    <div class="net-status">
      <div class="status-line"><span>Modem</span><span class="badge warn" id="modemBadge"><span class="dot"></span>da caricare</span></div>
      <div class="status-line"><span>Microfono</span><span class="badge" id="micBadge"><span class="dot"></span>spento</span></div>
      <div class="status-line"><span>Canale</span><span class="badge" id="carrierBadge"><span class="dot"></span>inattivo</span></div>
      <div class="status-line"><span>Turno</span><span class="badge" id="slotBadge">—</span></div>
      <div class="start-actions"><button class="btn" id="startBtn">Avvia rete</button><button class="btn secondary" id="announceBtn" disabled>Presentati</button></div>
    </div>
    <div class="section-head"><span>Dispositivi</span><span class="badge" id="deviceCount">0 vicini</span></div>
    <div class="devices" id="devices"></div>
  </aside>

  <main class="chat">
    <header class="chat-head">
      <button class="icon-btn mobile-menu" id="openSidebar">☰</button>
      <div class="avatar" id="chatAvatar">∞</div>
      <div class="chat-person"><div class="chat-title" id="chatTitle">Tutta la rete</div><div class="chat-sub" id="chatSub">broadcast cifrato · frame uniformi da 64 caratteri</div></div>
      <button class="icon-btn" id="dashboardBtn" title="Dashboard rete">◉</button>
      <button class="icon-btn" id="docsBtn" title="Protocollo aperto">⌘</button>
      <button class="icon-btn" id="settingsBtn" title="Impostazioni">⚙</button>
    </header>
    <section class="messages" id="messages"></section>
    <footer class="compose"><textarea id="messageInput" rows="1" maxlength="1200" placeholder="Scrivi un messaggio cifrato"></textarea><button class="send" id="sendBtn" disabled>➤</button></footer>
  </main>
</div>

<div class="overlay" id="dashboardOverlay"><div class="modal wide"><div class="modal-head"><h2>Network Intelligence</h2><button class="icon-btn closeModal">×</button></div><div class="modal-body">
  <div class="metrics"><div class="metric"><small>Nodi confermati</small><strong id="mNodes">1</strong><em>massimo 10</em></div><div class="metric"><small>Consegne</small><strong id="mDelivery">—</strong><em>ACK ricevuti</em></div><div class="metric"><small>Canale occupato</small><strong id="mBusy">0%</strong><em>ultimo minuto</em></div><div class="metric